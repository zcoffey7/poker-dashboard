{
  "name": "poker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test --test-reporter=spec lib/*.test.ts lib/standings/*.test.ts",
    "test:integration": "node --test --test-reporter=spec scripts/standings-integration.test.mjs && tsx --test --test-reporter=spec scripts/update-sheet-integration.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
